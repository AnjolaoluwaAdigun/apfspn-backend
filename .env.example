APP_NAME=APFSPN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (default): uses database/database.sqlite
DB_CONNECTION=sqlite
# DB_BUSY_TIMEOUT=10000
# DB_TRANSACTION_MODE=IMMEDIATE

# MySQL: comment out DB_CONNECTION above and uncomment these
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=apfspn
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes emails to storage/logs/laravel.log; use smtp in other environments
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@apfspn.test"
MAIL_FROM_NAME="${APP_NAME}"

# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=

APFSPN_ENCRYPTION_ENABLED=false
APFSPN_ENCRYPTION_KEY=

APFSPN_ACCESS_TTL_MINUTES=60
APFSPN_REFRESH_TTL_DAYS=30
APFSPN_ADMIN_TWO_FACTOR=false

# Invites the first super admin when db:seed runs
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=

FRONTEND_MEMBER_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3001
