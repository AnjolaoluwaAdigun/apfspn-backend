{
    "success": {
        "status": 200,
        "content_type": "application/json",
        "body": {
            "error": false,
            "message": "If the code was due, a new one has been sent.",
            "data": {
                "challenge_token": "{challenge_token}",
                "mode": "send_new",
                "expires_in": 599,
                "retry_after_seconds": 60
            }
        },
        "request": {
            "challenge_token": "{challenge_token}"
        }
    },
    "failure": {
        "status": 422,
        "content_type": "application/json",
        "body": {
            "error": true,
            "message": "The challenge token field is required.",
            "data": {
                "challenge_token": [
                    "{challenge_token}"
                ]
            }
        }
    }
}
