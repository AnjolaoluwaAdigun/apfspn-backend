{
    "failure": {
        "status": 403,
        "content_type": "application/json",
        "body": {
            "error": true,
            "message": "This account has been disabled.",
            "data": {
                "code": "account_disabled"
            }
        }
    },
    "success": {
        "status": 200,
        "content_type": "application/json",
        "body": {
            "error": false,
            "message": "Tokens refreshed.",
            "data": {
                "access_token": "{access_token}",
                "refresh_token": "{refresh_token}",
                "token_type": "Bearer",
                "expires_in": 3600,
                "refresh_expires_in": 2592000
            }
        },
        "request": []
    }
}
